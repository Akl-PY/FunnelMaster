---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PainPoints from '../components/PainPoints.astro';
import QuickWins from '../components/QuickWins.astro';
import SpecialSection from '../components/SpecialSection.astro';
import UniqueMechanism from '../components/UniqueMechanism.astro';
import TargetAudience from '../components/TargetAudience.astro';
import SolutionShowcase from '../components/SolutionShowcase.astro';
import SocialProof from '../components/SocialProof.astro';
import BonusStack from '../components/BonusStack.astro';
import PricingOffer from '../components/PricingOffer.astro';
import CreatorBio from '../components/CreatorBio.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

const checkoutUrl = "/checkout";
---
<BaseLayout 
  title="Sistema Liquidez Soberana & Cero Deudas™ | Salida Acelerada de Deudas y Blindaje de Sueldo"
  description="Corta el sangrado de intereses bancarios, libera entre $300 y $650 USD al mes de tu mismo sueldo desde tus primeras 48 horas y liquida tus tarjetas en la mitad de tiempo (sin usar planillas de Excel eternas).. Instala la **Arquitectura de Blindaje de Sueldo y Avalancha Inversa (ABAI)™**: el sistema operativo de 15 minutos al cobrar y App Móvil interactiva que divide tu ingreso en 4 Bóvedas Automáticas, congela intereses rotativos y te devuelve la paz mental antes de terminar esta semana.">
  <main class="min-h-screen">
    <HeroSection 
      kicker="PARA PROFESIONALES Y TRABAJADORES INDEPENDIENTES QUE VEN SU SUELDO EVAPORARSE EL DÍA 15 DEL MES EN TARJETAS, INTERESES Y GASTOS INVISIBLES"
      headline="Corta el sangrado de intereses bancarios, libera entre $300 y $650 USD al mes de tu mismo sueldo desde tus primeras 48 horas y liquida tus tarjetas en la mitad de tiempo (sin usar planillas de Excel eternas)."
      subheadline="Instala la **Arquitectura de Blindaje de Sueldo y Avalancha Inversa (ABAI)™**: el sistema operativo de 15 minutos al cobrar y App Móvil interactiva que divide tu ingreso en 4 Bóvedas Automáticas, congela intereses rotativos y te devuelve la paz mental antes de terminar esta semana."
      ctaText="Quiero Acceder al Sistema Hoy por $37 USD"
      checkoutUrl={checkoutUrl}
    />

    <!-- Modern Asymmetric Bento Grid Showcase -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 my-10 pb-24">
      
      <!-- Bento Row 1: Diagnóstico Visceral de Dolor (7 cols) + Simulador/Calculadora Interactivo (5 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <div class="lg:col-span-7 flex flex-col justify-stretch">
          <PainPoints />
        </div>
        <div class="lg:col-span-5 flex flex-col justify-stretch">
          <SpecialSection />
        </div>
      </div>

      <!-- Bento Row 2: Victorias Rápidas (Timeline Horizontal) -->
      <div class="w-full">
        <QuickWins />
      </div>

      <!-- Bento Row 3: Mecanismo Único (7 cols) + Radiografía por Dentro de la App Móvil (5 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <div class="lg:col-span-7 flex flex-col justify-stretch">
          <UniqueMechanism />
        </div>
        <div class="lg:col-span-5 flex flex-col justify-stretch">
          <SolutionShowcase />
        </div>
      </div>

      <!-- Bento Row 4: Filtro de Calificación (6 cols) + Casos de Estudio Verificados (6 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <div class="lg:col-span-6 flex flex-col justify-stretch">
          <TargetAudience />
        </div>
        <div class="lg:col-span-6 flex flex-col justify-stretch">
          <SocialProof />
        </div>
      </div>

      <!-- Bento Row 5: Bóveda de Bonos de Regalo -->
      <div class="w-full">
        <BonusStack />
      </div>

      <!-- Bento Row 6: Pasarela de Pago, Selector Stripe & Mercado Pago y Garantía de 30 Días -->
      <div class="max-w-3xl mx-auto w-full">
        <PricingOffer price={37} totalValue={237} checkoutUrl={checkoutUrl} />
      </div>

      <!-- Bento Row 7: Respaldo Metodológico + Preguntas Frecuentes -->
      <div class="max-w-3xl mx-auto w-full space-y-6">
        <CreatorBio />
        <FaqAccordion />
      </div>

    </div>

    <StickyMobileCTA price={37} checkoutUrl={checkoutUrl} />
  </main>
</BaseLayout>