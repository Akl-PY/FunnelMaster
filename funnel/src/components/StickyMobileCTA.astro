---
interface Props {
  price: number;
  checkoutUrl: string;
}
const { price, checkoutUrl } = Astro.props;
---
<div class="fixed bottom-0 left-0 right-0 z-50 sm:hidden bg-slate-950/95 backdrop-blur-md border-t border-slate-800 p-3 px-4 flex items-center justify-between shadow-2xl">
  <div>
    <div class="text-[10px] uppercase tracking-wider text-emerald-400 font-bold">Acceso + 4 Bonos + App</div>
    <div class="text-lg font-extrabold text-white">Solo \${price} USD <span class="text-xs text-slate-400 line-through font-normal">$237</span></div>
  </div>
  <a href={checkoutUrl} class="checkout-btn px-5 py-3 rounded-xl bg-gradient-to-r from-[#10B981] to-[#F59E0B] text-slate-950 font-extrabold text-xs shadow-lg">
    Acceder Ahora →
  </a>
</div>